@@ -0,0 +1,339 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  scoreFLR, abilityBand, readinessBand, need, ability, InvalidResponseError,
+  ALGORITHM_VERSION, INSTRUMENT_CODE, ITEM_KEYS,
+  type Responses, type SafetyStatus
+} from '../src/flr-readiness-01.ts';
+
+/** Q-number shorthand so cases read like the spec. Unlisted items = 0. */
+const Q = (qs: Partial<Record<number, 0 | 1 | 2 | 3 | null>> = {}): Responses =>
+  Object.fromEntries(ITEM_KEYS.map((k, i) => [k, (i + 1) in qs ? qs[i + 1] : 0])) as Responses;
+const run = (qs: Partial<Record<number, 0 | 1 | 2 | 3 | null>> = {}, safety: SafetyStatus | null = 'no') =>
+  scoreFLR({ responses: Q(qs), safety });
+
+describe('transforms', () => {
+  test('need and ability run in opposite directions', () => {
+    assert.equal(need(0), 0);   assert.equal(need(3), 100);
+    assert.equal(ability(0), 100); assert.equal(ability(3), 0);
+    assert.equal(Math.round(need(1) * 100) / 100, 33.33);
+    assert.equal(Math.round(ability(1) * 100) / 100, 66.67);
+  });
+});
+
+describe('ability score and bands', () => {
+  test('band edges', () => {
+    assert.equal(abilityBand(100), 'performance');
+    assert.equal(abilityBand(80), 'performance');
+    assert.equal(abilityBand(79.9), 'building');
+    assert.equal(abilityBand(55), 'building');
+    assert.equal(abilityBand(54.9), 'foundation');
+    assert.equal(abilityBand(0), 'foundation');
+  });
+
+  test('no limitation = 100 performance', () => {
+    const r = run();
+    assert.equal(r.ability.score, 100);
+    assert.equal(r.ability.level, 'performance');
+    assert.deepEqual(r.ability.reasons, []);
+  });
+
+  test('Q8=2 alone lands exactly on 80.0 performance', () => {
+    const r = run({ 8: 2 });
+    assert.equal(r.ability.score, 80);
+    assert.equal(r.ability.level, 'performance');
+  });
+
+  test('Q4=2, Q8=2 = 66.7 building (two moderates is not three)', () => {
+    const r = run({ 4: 2, 8: 2 });
+    assert.equal(r.ability.score, 66.7);
+    assert.equal(r.ability.level, 'building');
+    assert.deepEqual(r.ability.reasons, []);
+  });
+
+  test('Q4=2, Q5-7=1, Q8=2 = 50.0 foundation by score', () => {
+    const r = run({ 4: 2, 5: 1, 6: 1, 7: 1, 8: 2 });
+    assert.equal(r.ability.score, 50);
+    assert.equal(r.ability.calculated_level, 'foundation');
+    assert.equal(r.ability.level, 'foundation');
+    assert.deepEqual(r.ability.reasons, []);
+  });
+});
+
+describe('ability overrides', () => {
+  test('Q8=3 forces foundation over a calculated building', () => {
+    const r = run({ 8: 3 });
+    assert.equal(r.ability.score, 70);
+    assert.equal(r.ability.calculated_level, 'building');
+    assert.equal(r.ability.level, 'foundation');
+    assert.deepEqual(r.ability.reasons, ['FORCE_FOUNDATION_INDEPENDENCE_SIGNIFICANT']);
+  });
+
+  test('three of Q4-Q8 at >=2 forces foundation', () => {
+    const r = run({ 4: 2, 5: 2, 6: 2 });
+    assert.equal(r.ability.score, 66.7);
+    assert.equal(r.ability.level, 'foundation');
+    assert.deepEqual(r.ability.reasons, ['FORCE_FOUNDATION_THREE_MODERATE']);
+  });
+
+  test('any Q4-Q8 = 3 caps a calculated performance at building', () => {
+    const r = run({ 7: 3 });
+    assert.equal(r.ability.score, 80);
+    assert.equal(r.ability.calculated_level, 'performance');
+    assert.equal(r.ability.level, 'building');
+    assert.deepEqual(r.ability.reasons, ['CAP_BUILDING_SIGNIFICANT_ITEM']);
+  });
+
+  test('cap records but does not raise a calculated foundation', () => {
+    const r = run({ 4: 3, 5: 3, 6: 1, 7: 1 });
+    assert.equal(r.ability.calculated_level, 'foundation');
+    assert.equal(r.ability.level, 'foundation');
+    assert.deepEqual(r.ability.reasons, ['CAP_BUILDING_SIGNIFICANT_ITEM']);
+  });
+});
+
+describe('readiness index and bands', () => {
+  test('band edges', () => {
+    assert.equal(readinessBand(75), 'standard_start');
+    assert.equal(readinessBand(74.9), 'modified_start');
+    assert.equal(readinessBand(50), 'modified_start');
+    assert.equal(readinessBand(49.9), 'professional_review');
+  });
+
+  test('no limitation = 100 standard start', () => {
+    const r = run();
+    assert.equal(r.readiness.index, 100);
+    assert.equal(r.readiness.route, 'standard_start');
+    assert.deepEqual(r.readiness.reasons, []);
+  });
+
+  test('Q1=1 = 95 standard', () => {
+    assert.equal(run({ 1: 1 }).readiness.index, 95);
+  });
+
+  test('every item mild = 66.7 modified by band, no override', () => {
+    const r = run({ 1: 1, 2: 1, 3: 1, 4: 1, 5: 1, 6: 1, 7: 1, 8: 1, 9: 1, 10: 1 });
+    assert.equal(r.readiness.index, 66.7);
+    assert.equal(r.readiness.calculated_route, 'modified_start');
+    assert.equal(r.readiness.route, 'modified_start');
+    assert.deepEqual(r.readiness.reasons, []);
+  });
+
+  test('every readiness item moderate = 33.3 professional review by band', () => {
+    const r = run({ 1: 2, 2: 2, 3: 2, 6: 2, 8: 2, 9: 2, 10: 2 });
+    assert.equal(r.readiness.index, 33.3);
+    assert.equal(r.readiness.route, 'professional_review');
+    assert.deepEqual(r.readiness.reasons, ['TWO_OR_MORE_MODERATE_READINESS_ITEMS']);
+  });
+
+  test('one moderate item stays standard', () => {
+    const r = run({ 3: 2 });
+    assert.equal(r.readiness.index, 90);
+    assert.equal(r.readiness.route, 'standard_start');
+  });
+});
+
+describe('readiness professional-review overrides', () => {
+  const cases: [string, Partial<Record<number, 0 | 1 | 2 | 3>>, SafetyStatus | null, string][] = [
+    ['safety = yes', {}, 'yes', 'SAFETY_YES'],
+    ['safety = not sure', {}, 'not_sure', 'SAFETY_NOT_SURE'],
+    ['safety unanswered', {}, null, 'SAFETY_UNANSWERED'],
+    ['Q2 = 3', { 2: 3 }, 'no', 'STRUCTURE_SIGNIFICANT'],
+    ['Q9 = 3', { 9: 3 }, 'no', 'BALANCE_CONFIDENCE_SIGNIFICANT'],
+    ['Q1 = 3 and Q8 >= 2', { 1: 3, 8: 2 }, 'no', 'RECENT_CHANGE_WITH_INDEPENDENCE_LIMIT'],
+    ['Q1 = 3 and Q10 >= 2', { 1: 3, 10: 2 }, 'no', 'RECENT_CHANGE_WITH_PARTICIPATION_LIMIT'],
+    ['two of Q3/Q6/Q8/Q10 = 3', { 3: 3, 6: 3 }, 'no', 'MULTIPLE_SIGNIFICANT_LIMITS']
+  ];
+  for (const [name, qs, safety, code] of cases) {
+    test(name, () => {
+      const r = run(qs, safety);
+      assert.equal(r.readiness.route, 'professional_review');
+      assert.ok(r.readiness.reasons.includes(code as never), `expected ${code} in ${r.readiness.reasons}`);
+    });
+  }
+
+  test('safety = yes overrides a perfect index', () => {
+    const r = run({}, 'yes');
+    assert.equal(r.readiness.index, 100);
+    assert.equal(r.readiness.calculated_route, 'standard_start');
+    assert.equal(r.readiness.route, 'professional_review');
+  });
+
+  test('Q1 = 3 with Q8 = 1 is not professional review', () => {
+    assert.notEqual(run({ 1: 3, 8: 1 }).readiness.route, 'professional_review');
+  });
+});
+
+describe('readiness modified-start overrides', () => {
+  test('two readiness items >= 2 force modified over a standard index', () => {
+    const r = run({ 3: 2, 10: 2 });
+    assert.equal(r.readiness.index, 83.3);
+    assert.equal(r.readiness.calculated_route, 'standard_start');
+    assert.equal(r.readiness.route, 'modified_start');
+    assert.deepEqual(r.readiness.reasons, ['TWO_OR_MORE_MODERATE_READINESS_ITEMS']);
+  });
+
+  test('one non-override readiness item = 3 forces modified', () => {
+    const r = run({ 3: 3 });
+    assert.equal(r.readiness.index, 85);
+    assert.equal(r.readiness.route, 'modified_start');
+    assert.deepEqual(r.readiness.reasons, ['SIGNIFICANT_READINESS_ITEM']);
+  });
+
+  test('Q1 = 3 with Q8 = 1 is modified, not professional review', () => {
+    const r = run({ 1: 3, 8: 1 });
+    assert.equal(r.readiness.index, 78.3);
+    assert.equal(r.readiness.route, 'modified_start');
+    assert.deepEqual(r.readiness.reasons, ['SIGNIFICANT_READINESS_ITEM']);
+  });
+
+  test('ability-only items (Q4, Q5, Q7) do not trigger readiness overrides', () => {
+    const r = run({ 4: 3, 5: 3, 7: 2 });
+    assert.equal(r.readiness.route, 'standard_start');
+    assert.deepEqual(r.readiness.reasons, []);
+  });
+});
+
+describe('four lenses', () => {
+  test('capacity-dominant, no secondary when second is far and < 40', () => {
+    const r = run({ 4: 3, 5: 3, 6: 3 });
+    assert.deepEqual(r.lenses.needs, { structure: 0, capacity: 100, function: 20, experience: 0 });
+    assert.equal(r.lenses.profile, 'focused');
+    assert.equal(r.lenses.primary, 'capacity');
+    assert.equal(r.lenses.secondary, null);
+  });
+
+  test('function formula weights', () => {
+    const r = run({ 8: 3 });
+    assert.equal(r.lenses.needs.function, 35);
+    assert.equal(r.lenses.primary, 'function');
+  });
+
+  test('experience formula weights', () => {
+    const r = run({ 1: 3, 3: 3, 9: 3, 10: 3 });
+    assert.equal(r.lenses.needs.experience, 100);
+    assert.equal(run({ 10: 3 }).lenses.needs.experience, 40);
+  });
+
+  test('secondary when within 15 points of primary', () => {
+    const r = run({ 2: 1, 10: 2 });
+    assert.equal(r.lenses.needs.structure, 33.3);
+    assert.equal(r.lenses.needs.experience, 26.7);
+    assert.equal(r.lenses.primary, 'structure');
+    assert.equal(r.lenses.secondary, 'experience');
+  });
+
+  test('secondary when second is >= 40 even if far behind', () => {
+    const r = run({ 2: 3, 10: 3 });
+    assert.equal(r.lenses.primary, 'structure');
+    assert.equal(r.lenses.needs.experience, 40);
+    assert.equal(r.lenses.secondary, 'experience');
+  });
+
+  test('no secondary when gap > 15 and second < 40', () => {
+    const r = run({ 2: 2, 10: 2 });
+    assert.equal(r.lenses.primary, 'structure');
+    assert.equal(r.lenses.secondary, null);
+  });
+
+  test('tie resolves by canonical lens order and is flagged', () => {
+    const r = run({ 2: 3, 4: 3, 5: 3, 6: 3 });
+    assert.equal(r.lenses.needs.structure, 100);
+    assert.equal(r.lenses.needs.capacity, 100);
+    assert.equal(r.lenses.primary, 'structure');
+    assert.equal(r.lenses.secondary, 'capacity');
+    assert.equal(r.lenses.primary_tied, true);
+  });
+
+  test('all lenses < 25 returns balanced profile with no primary', () => {
+    const r = run({ 10: 1, 3: 1 });
+    assert.equal(r.lenses.profile, 'balanced');
+    assert.equal(r.lenses.primary, null);
+    assert.equal(r.lenses.secondary, null);
+  });
+});
+
+describe('pillar 1 priority profile', () => {
+  test('ranked by need, ties keep canonical category order, power is a strength sub-signal', () => {
+    const r = run({ 3: 2, 4: 3 });
+    const byKey = Object.fromEntries(r.pillar1.map(e => [e.key, e]));
+    assert.equal(byKey.strength.need, 60);
+    assert.equal(byKey.joint_health.need, 66.7);
+    assert.deepEqual(r.pillar1.map(e => e.key),
+      ['joint_health', 'strength', 'functional_independence', 'mobility', 'endurance', 'power']);
+    assert.deepEqual(r.pillar1.map(e => e.rank), [1, 2, 3, 4, 5, 6]);
+    assert.equal(byKey.power.category_key, 'P1-C4');
+    assert.equal(byKey.power.subsignal, true);
+    assert.equal(byKey.endurance.category_key, 'P1-C5');
+  });
+});
+
+describe('missing / skipped responses', () => {
+  test('skipping Q8 withholds ability (coverage 0.70) and forces foundation', () => {
+    const r = run({ 8: null });
+    assert.equal(r.answered_count, 9);
+    assert.equal(r.ability.score, null);
+    assert.equal(r.ability.level, 'foundation');
+    assert.deepEqual(r.ability.reasons, ['INSUFFICIENT_DATA']);
+  });
+
+  test('skipping Q8 still scores readiness by renormalising (coverage 0.80)', () => {
+    const r = run({ 8: null });
+    assert.equal(r.readiness.index, 100);
+    assert.equal(r.readiness.route, 'standard_start');
+  });
+
+  test('skipping Q4 renormalises ability over answered weight', () => {
+    const r = run({ 4: null, 8: 2 });
+    assert.equal(r.ability.score, 75); // (15 + 15 + 20 + 10) / 0.80
+    assert.equal(r.ability.level, 'building');
+  });
+
+  test('skipped items never trigger an override', () => {
+    const r = run({ 1: 3, 8: null, 10: null });
+    assert.ok(!r.readiness.reasons.includes('RECENT_CHANGE_WITH_INDEPENDENCE_LIMIT'));
+    assert.ok(!r.readiness.reasons.includes('RECENT_CHANGE_WITH_PARTICIPATION_LIMIT'));
+    assert.equal(r.readiness.route, 'modified_start');
+  });
+
+  test('a lens missing too much weight is null and excluded from ranking', () => {
+    const r = run({ 8: null, 2: 1 });
+    assert.equal(r.lenses.needs.function, null);
+    assert.equal(r.lenses.primary, 'structure');
+    const fi = r.pillar1.find(e => e.key === 'functional_independence')!;
+    assert.equal(fi.need, null);
+    assert.equal(fi.rank, null);
+    assert.equal(r.pillar1.at(-1)!.key, 'functional_independence');
+  });
+
+  test('nothing answered: conservative routes, no primary lens', () => {
+    const r = scoreFLR({ responses: {}, safety: 'no' });
+    assert.equal(r.answered_count, 0);
+    assert.equal(r.ability.level, 'foundation');
+    assert.equal(r.readiness.index, null);
+    assert.equal(r.readiness.route, 'modified_start');
+    assert.deepEqual(r.readiness.reasons, ['INSUFFICIENT_DATA']);
+    assert.equal(r.lenses.profile, 'insufficient_data');
+  });
+});
+
+describe('validation and reproducibility', () => {
+  test('rejects out-of-range, non-integer and unknown items', () => {
+    assert.throws(() => scoreFLR({ responses: { joint_limitation: 4 as never }, safety: 'no' }), InvalidResponseError);
+    assert.throws(() => scoreFLR({ responses: { joint_limitation: 1.5 as never }, safety: 'no' }), InvalidResponseError);
+    assert.throws(() => scoreFLR({ responses: { joint_limitation: '2' as never }, safety: 'no' }), InvalidResponseError);
+    assert.throws(() => scoreFLR({ responses: { grip: 1 } as never, safety: 'no' }), InvalidResponseError);
+    assert.throws(() => scoreFLR({ responses: {}, safety: 'maybe' as never }), InvalidResponseError);
+  });
+
+  test('same input gives an identical, versioned result and does not mutate input', () => {
+    const input = { responses: Q({ 1: 2, 4: 1, 9: 2 }), safety: 'no' as const };
+    const frozen = JSON.stringify(input);
+    const a = scoreFLR(input), b = scoreFLR(input);
+    assert.deepEqual(a, b);
+    assert.equal(JSON.stringify(input), frozen);
+    assert.equal(a.instrument_code, INSTRUMENT_CODE);
+    assert.equal(a.algorithm_version, ALGORITHM_VERSION);
+    assert.equal(a.responses.recent_health_change, 2);
+  });
+});
